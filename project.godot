; Engine configuration file.
; Ported from Expo/React Native app.json (portrait, Android-first).

config_version=5

[application]

config/name="Noonvaei"
config/name_localized={
"fa": "نانوایی سنگک"
}
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game/game_state.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.725, 0.851, 0.561, 1)
